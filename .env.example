# Customer Insights Platform – Environment Variables Template
# Copy this file to .env and fill in your custom values

# Application Metadata
APP_NAME=CUSTOMER INSIGHTS PLATFORM
APP_SUBTITLE=AI-Powered Customer Intelligence Platform
COMPANY_NAME=Apex Electronics Retail Inc.
APP_VERSION=v3.0 Enterprise
TAGLINE=Turn raw data into confident decisions.

# Database Path (Optional override)
# DB_PATH=database/insightpulse.db

# Google OAuth Credentials (Optional)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8501
